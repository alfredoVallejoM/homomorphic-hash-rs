{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/algesum/c3-factor-plan-v1.schema.json",
  "title": "Algesum C3 deterministic factor plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "campaign_id", "seed", "shards"],
  "properties": {
    "schema": { "const": "algesum-c3-factor-plan-v1" },
    "campaign_id": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer", "minimum": 0 },
    "shards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/shard" }
    }
  },
  "$defs": {
    "factor-value": {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "string", "minLength": 1 }
      ]
    },
    "factor-map": {
      "type": "object",
      "propertyNames": {
        "enum": ["scale", "payload_bytes", "dataset_size", "strategy"]
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/factor-value" }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "operation": { "type": "string", "minLength": 1 },
        "strategy": { "type": "string", "minLength": 1 },
        "baseline": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "maximum_scale": { "type": "integer", "minimum": 1 }
      }
    },
    "shard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "scale_unit",
        "operations",
        "primary_factors"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "family": { "type": "string", "minLength": 1 },
        "scale_unit": { "type": "string", "minLength": 1 },
        "preflight_max_scale": { "type": "integer", "minimum": 1 },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/operation" }
        },
        "primary_factors": {
          "allOf": [
            { "$ref": "#/$defs/factor-map" },
            { "required": ["scale"] }
          ]
        },
        "secondary_factors": { "$ref": "#/$defs/factor-map" }
      }
    }
  }
}
