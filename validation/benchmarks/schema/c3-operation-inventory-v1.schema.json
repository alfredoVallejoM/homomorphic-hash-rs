{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/algesum/c3-operation-inventory-v1.schema.json",
  "title": "Algesum C3 operation implementation inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "campaign_id", "suites"],
  "properties": {
    "schema": { "const": "algesum-c3-operation-inventory-v1" },
    "campaign_id": { "type": "string", "minLength": 1 },
    "suites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "implemented_operations", "missing_operations"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["implemented", "partial", "external", "missing"] },
          "implemented_operations": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "missing_operations": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "external_runner": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
