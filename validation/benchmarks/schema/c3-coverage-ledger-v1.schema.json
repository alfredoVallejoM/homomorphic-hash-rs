{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/algesum/c3-coverage-ledger-v1.schema.json",
  "title": "Algesum C3 coverage ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "campaign_id",
    "security_classification",
    "status",
    "targets",
    "suites",
    "coverage"
  ],
  "properties": {
    "schema": { "const": "algesum-c3-coverage-ledger-v1" },
    "campaign_id": { "type": "string", "minLength": 1 },
    "security_classification": {
      "const": "non-cryptographic-algebraic-summaries"
    },
    "status": { "enum": ["planned", "running", "complete"] },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_semantic_cases",
        "timed_cells_lower_bound",
        "timed_cells_upper_bound",
        "systems_scenarios_lower_bound",
        "systems_scenarios_upper_bound",
        "minimum_processes_per_timed_cell"
      ],
      "properties": {
        "minimum_semantic_cases": { "type": "integer", "minimum": 1 },
        "timed_cells_lower_bound": { "type": "integer", "minimum": 1 },
        "timed_cells_upper_bound": { "type": "integer", "minimum": 1 },
        "systems_scenarios_lower_bound": { "type": "integer", "minimum": 1 },
        "systems_scenarios_upper_bound": { "type": "integer", "minimum": 1 },
        "minimum_processes_per_timed_cell": { "type": "integer", "minimum": 30 }
      }
    },
    "suites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "lane", "primary_axes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "lane": { "enum": ["semantic", "scaling", "systems", "mixed"] },
          "primary_axes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "suite", "mode", "questions"],
        "properties": {
          "capability": { "type": "string", "minLength": 1 },
          "suite": { "type": "string", "minLength": 1 },
          "mode": {
            "enum": ["semantic+timed", "semantic+systems", "semantic-only", "context-only", "excluded"]
          },
          "questions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "exclusion_reason": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "mode": { "const": "excluded" } } },
            "then": { "required": ["exclusion_reason"] }
          }
        ]
      }
    }
  }
}
