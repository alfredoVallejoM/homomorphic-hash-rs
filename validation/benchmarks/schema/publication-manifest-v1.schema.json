{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/microfield/publication-manifest-v1.schema.json",
  "title": "Microfield publication benchmark manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "campaign_id", "profile", "seed", "host_mode",
    "minimum_processes", "maximum_processes", "precision_check_every",
    "warmup_observations", "measured_observations", "target_observation_ns",
    "maximum_batch_iterations", "bootstrap_resamples",
    "maximum_relative_ci_half_width", "cells"
  ],
  "properties": {
    "schema": { "const": "microfield-publication-benchmark-manifest-v1" },
    "campaign_id": { "type": "string", "minLength": 1 },
    "profile": { "enum": ["smoke", "pilot", "publication"] },
    "seed": { "type": "integer", "minimum": 0 },
    "host_mode": { "enum": ["ci-shared", "interactive", "dedicated"] },
    "minimum_processes": { "type": "integer", "minimum": 2, "maximum": 100 },
    "maximum_processes": { "type": "integer", "minimum": 2, "maximum": 100 },
    "precision_check_every": { "type": "integer", "minimum": 1 },
    "warmup_observations": { "type": "integer", "minimum": 1 },
    "measured_observations": { "type": "integer", "minimum": 3 },
    "target_observation_ns": { "type": "integer", "minimum": 1 },
    "maximum_batch_iterations": { "type": "integer", "minimum": 1 },
    "bootstrap_resamples": { "type": "integer", "minimum": 100 },
    "maximum_relative_ci_half_width": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.5 },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/cell" }
    }
  },
  "$defs": {
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "operation", "scale", "scale_unit"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "maxLength": 160 },
        "family": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "scale": { "type": "integer", "minimum": 1 },
        "scale_unit": { "type": "string", "minLength": 1 },
        "payload_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "baseline_cell": { "type": "string" },
        "curve": { "type": "string" },
        "strategy": { "type": "string" }
      }
    }
  }
}
