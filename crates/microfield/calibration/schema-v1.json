{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microfield.invalid/calibration/schema-v1.json",
  "title": "Microfield calibration profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile_id",
    "source_commit",
    "environment",
    "criterion",
    "measurements"
  ],
  "properties": {
    "schema": { "const": 1 },
    "profile_id": { "type": "string", "minLength": 1 },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "cpu_family",
        "cpu_model",
        "microcode",
        "os",
        "kernel",
        "rustc",
        "llvm",
        "profile"
      ],
      "properties": {
        "architecture": { "enum": ["x86_64", "aarch64"] },
        "cpu_family": { "type": "string", "minLength": 1 },
        "cpu_model": { "type": "string", "minLength": 1 },
        "microcode": { "type": "string", "minLength": 1 },
        "os": { "type": "string", "minLength": 1 },
        "kernel": { "type": "string", "minLength": 1 },
        "rustc": { "type": "string", "minLength": 1 },
        "llvm": { "type": "string", "minLength": 1 },
        "profile": { "const": "bench" }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_samples", "warm_up_seconds", "measurement_seconds"],
      "properties": {
        "minimum_samples": { "type": "integer", "minimum": 10 },
        "warm_up_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "measurement_seconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "operation",
          "region",
          "batch_len",
          "backend",
          "lower_ns",
          "upper_ns"
        ],
        "properties": {
          "field": {
            "enum": ["gf2_128_v1", "gf2_256_hh_v1", "gf2_256_alt_v1"]
          },
          "operation": { "enum": ["mul", "square", "pack", "unpack"] },
          "region": { "enum": ["engine", "kernel", "pipeline_reused"] },
          "batch_len": { "type": "integer", "minimum": 1 },
          "backend": {
            "enum": ["portable", "x86_pclmul", "x86_vpclmul", "aarch64_pmull"]
          },
          "lower_ns": { "type": "number", "exclusiveMinimum": 0 },
          "upper_ns": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  }
}
